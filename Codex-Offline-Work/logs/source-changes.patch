+            raise ValueError("BootShim base/size does not match the target build configuration")
+        if len(fd_data) != self.uefi_size:
+            raise ValueError(
+                f"UEFI FD length {len(fd_data)} does not match UEFI_SIZE {self.uefi_size}")
